; mod p arithmetic for:  x+x*x
; aka:  Add(l=Var(name='x'), r=Mul(l=Var(name='x'), r=Var(name='x')))
(set-logic QF_NIA)
(set-info :smt-lib-version 2.6)
(set-info :category "crafted")
(set-info :status unsat)
(define-fun p () Int 3564220999)
(define-fun q () Int 43919445343830683577159856201368791907095106593946579252785688310981123143863)
(declare-const q_0 Int)
(assert (and (<= 0 q_0) (< q_0 q)))
(assert (and (<= 0 q_0) (< q_0 p)))
(declare-const r_0 Int)
(assert (and (<= 0 r_0) (< r_0 q)))
(assert (and (<= 0 r_0) (< r_0 p)))
(declare-const x Int)
(assert (and (<= 0 x) (< x q)))
(assert (and (<= 0 x) (< x p)))
(declare-const q_1 Int)
(assert (and (<= 0 q_1) (< q_1 q)))
(assert (and (<= 0 q_1) (< q_1 p)))
(declare-const r_1 Int)
(assert (and (<= 0 r_1) (< r_1 q)))
(assert (and (<= 0 r_1) (< r_1 p)))
(assert (= (mod (- (* x x) (+ (* q_1 p) r_1)) q) 0))
(assert (= (mod (- (+ x r_1) (+ (* q_0 p) r_0)) q) 0))
(assert (not (= (mod (- r_0 (+ x (* x x))) p) 0)))
(check-sat)
